{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "siamrooftech-local",
  "account_id": "7d77d1239789304d1351db90f4cc2686",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-06-06",
  "compatibility_flags": ["nodejs_compat", "no_handle_cross_request_promise_resolution"],
  "send_email": [
    { "name": "AUTH_EMAIL", "allowed_sender_addresses": ["noreply@siamrooftech.com"] }
  ],
  "d1_databases": [
    {
      "binding": "APP_DB",
      "database_name": "siamrooftech-cms-local",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "drizzle/migrations"
    },
    {
      "binding": "NEXT_TAG_CACHE_D1",
      "database_name": "siamrooftech-cache-local",
      "database_id": "00000000-0000-0000-0000-000000000002",
      "migrations_dir": "drizzle/cache-migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "siamrooftech-opennext-cache"
    }
  ],
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "siamrooftech-local"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "NEXT_CACHE_DO_QUEUE",
        "class_name": "DOQueueHandler"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["DOQueueHandler"]
    }
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "vars": {
    "DEPLOY_ENV": "local",
    "SITE_ORIGIN": "http://localhost:3000",
    "PROJECTS_SOURCE_URL": "https://www.siamrooftech.com",
    "INDEX_POLICY": "noindex",
    "AUTH_EMAIL_DELIVERY": "disabled",
    "AUTH_EMAIL_FROM": "noreply@siamrooftech.com",
    "NEXT_PUBLIC_GA4_MEASUREMENT_ID": "G-49Q49WM381",
    "NEXT_PUBLIC_GOOGLE_ADS_ID": "",
    "NEXT_PUBLIC_GOOGLE_ADS_LINE_CONVERSION_LABEL": "",
    "LINE_CHAT_HISTORY_WORKER_URL": "https://siamrooftech-line-chat-history.doubledoors.workers.dev"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    }
  },
  "env": {
    "staging": {
      "name": "siamrooftech-staging",
      "workers_dev": false,
      "routes": [
        { "pattern": "staging.siamrooftech.com/*", "zone_name": "siamrooftech.com" }
      ],
      "send_email": [
        { "name": "AUTH_EMAIL", "allowed_sender_addresses": ["noreply@siamrooftech.com"] }
      ],
      "d1_databases": [
        {
          "binding": "APP_DB",
          "database_name": "siamrooftech-cms-staging",
          "database_id": "18e548a4-1fb5-4243-bcb7-d0fa045b9766",
          "migrations_dir": "drizzle/migrations"
        },
        {
          "binding": "NEXT_TAG_CACHE_D1",
          "database_name": "siamrooftech-cache-staging",
          "database_id": "0a67d446-80ce-4a60-839d-c9ca2557671f",
          "migrations_dir": "drizzle/cache-migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "NEXT_INC_CACHE_R2_BUCKET",
          "bucket_name": "siamrooftech-opennext-cache-staging"
        }
      ],
      "services": [
        {
          "binding": "WORKER_SELF_REFERENCE",
          "service": "siamrooftech-staging"
        }
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "NEXT_CACHE_DO_QUEUE",
            "class_name": "DOQueueHandler"
          }
        ]
      },
      "assets": {
        "directory": ".open-next/assets",
        "binding": "ASSETS"
      },
      "vars": {
        "DEPLOY_ENV": "staging",
        "SITE_ORIGIN": "https://staging.siamrooftech.com",
        "PROJECTS_SOURCE_URL": "https://www.siamrooftech.com",
        "INDEX_POLICY": "noindex",
        "AUTH_EMAIL_DELIVERY": "live",
        "AUTH_EMAIL_FROM": "noreply@siamrooftech.com",
        "NEXT_PUBLIC_GA4_MEASUREMENT_ID": "",
        "NEXT_PUBLIC_GOOGLE_ADS_ID": "",
        "NEXT_PUBLIC_GOOGLE_ADS_LINE_CONVERSION_LABEL": "",
        "NEXT_PUBLIC_OPENAI_PIXEL_ID": "",
        "LINE_CHAT_HISTORY_WORKER_URL": ""
      }
    },
    "production": {
      "name": "siamrooftech",
      "workers_dev": false,
      "routes": [
        { "pattern": "www.siamrooftech.com/*", "zone_name": "siamrooftech.com" }
      ],
      "d1_databases": [
        {
          "binding": "APP_DB",
          "database_name": "siamrooftech-cms-production",
          "database_id": "313c98d1-1852-4222-94ae-f3f57d46f793",
          "migrations_dir": "drizzle/migrations"
        },
        {
          "binding": "NEXT_TAG_CACHE_D1",
          "database_name": "siamrooftech-cache-production",
          "database_id": "f4c15b50-fe69-4b0a-93fc-4c8bd8250471",
          "migrations_dir": "drizzle/cache-migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "MEDIA_BUCKET",
          "bucket_name": "siamrooftech-media-production"
        },
        {
          "binding": "NEXT_INC_CACHE_R2_BUCKET",
          "bucket_name": "siamrooftech-opennext-cache-production"
        }
      ],
      "send_email": [
        { "name": "AUTH_EMAIL", "allowed_sender_addresses": ["noreply@siamrooftech.com"] }
      ],
      "services": [
        { "binding": "WORKER_SELF_REFERENCE", "service": "siamrooftech" }
      ],
      "durable_objects": {
        "bindings": [
          { "name": "NEXT_CACHE_DO_QUEUE", "class_name": "DOQueueHandler" }
        ]
      },
      "assets": {
        "directory": ".open-next/assets",
        "binding": "ASSETS"
      },
      "vars": {
        "DEPLOY_ENV": "production",
        "SITE_ORIGIN": "https://www.siamrooftech.com",
        "INDEX_POLICY": "index",
        "AUTH_EMAIL_DELIVERY": "live",
        "AUTH_EMAIL_FROM": "noreply@siamrooftech.com",
        "NEXT_PUBLIC_GA4_MEASUREMENT_ID": "G-49Q49WM381",
        "NEXT_PUBLIC_GOOGLE_ADS_ID": "AW-18580306711",
        "NEXT_PUBLIC_GOOGLE_ADS_LINE_CONVERSION_LABEL": "sZCPCOnW_b0dEJf245tF",
        "NEXT_PUBLIC_OPENAI_PIXEL_ID": "CXx4Njj3BUmjXMcbnmRsdC",
        "LINE_CHAT_HISTORY_WORKER_URL": "https://siamrooftech-line-chat-history.doubledoors.workers.dev"
      }
    }
  }
}
