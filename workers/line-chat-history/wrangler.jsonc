{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "siamrooftech-line-chat-history",
  "account_id": "7d77d1239789304d1351db90f4cc2686",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-17",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "vars": {
    "MEDIA_MAX_BYTES": "26214400",
    "CRM_ADS_LIVE_ENABLED": "false",
    "RELEASE_SHA": "local"
  },
  "d1_databases": [
    {
      "binding": "CHAT_DB",
      "database_name": "siamrooftech-line-chat",
      "database_id": "d2ec877f-815f-4bc8-890c-edc8af94e82b"
    }
  ],
  "r2_buckets": [
    {
      "binding": "CHAT_MEDIA",
      "bucket_name": "siamrooftech-line-chat-media"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "MEDIA_QUEUE",
        "queue": "line-media-fetch"
      },
      {
        "binding": "ADS_QUEUE",
        "queue": "line-ads-sync"
      }
    ],
    "consumers": [
      {
        "queue": "line-media-fetch",
        "max_batch_size": 5,
        "max_batch_timeout": 10,
        "max_retries": 5,
        "max_concurrency": 2,
        "dead_letter_queue": "line-media-fetch-dlq"
      },
      {
        "queue": "line-ads-sync",
        "max_batch_size": 5,
        "max_batch_timeout": 10,
        "max_retries": 5,
        "max_concurrency": 1,
        "dead_letter_queue": "line-ads-sync-dlq"
      }
    ]
  },
  "triggers": {
    "crons": [
      "*/15 * * * *"
    ]
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    }
  },
  "env": {
    "staging": {
      "name": "siamrooftech-line-chat-history-staging",
