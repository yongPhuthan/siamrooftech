{
  "name": "siamrooftech-ip-block-edge",
  "main": "edge.mjs",
  "compatibility_date": "2025-09-01",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "www.siamrooftech.com/__ipb*", "zone_name": "siamrooftech.com" }],
  "services": [{ "binding": "BLOCKER", "service": "siamrooftech-ip-block-google" }],
  "ratelimits": [{
    "name": "RATE_LIMITER",
    "namespace_id": "4401",
    "simple": { "limit": 3, "period": 60 }
  }]
}
