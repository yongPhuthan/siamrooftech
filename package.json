{
  "name": "siamrooftech",
  "version": "0.1.0",
  "private": true,
  "packageManager": "yarn@1.22.22",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "type-check": "yarn cf:types && tsc --noEmit",
    "test": "yarn test:admin && yarn test:articles && yarn test:seed",
    "test:articles": "vitest run --config vitest.articles.config.ts",
    "test:seed": "node --import tsx --test scripts/seed-projects.test.mjs",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "docs:serve": "npx serve docs -p 3001",
    "docs:open": "open http://localhost:3001",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply siamrooftech-cms-local --local",
    "db:migrate:cache:local": "wrangler d1 migrations apply siamrooftech-cache-local --local",
    "db:inspect:local": "wrangler d1 execute siamrooftech-cms-local --local --command=\"SELECT name FROM sqlite_master WHERE type IN ('table','view') ORDER BY name\"",
    "db:seed:local": "node --import tsx scripts/seed-projects.mjs",
    "db:seed:staging": "node --import tsx scripts/seed-projects.mjs --target staging --apply",
    "db:test:local": "node scripts/cms-database-qa.mjs",
    "cms:qa:local": "node --import tsx scripts/cms-app-local-qa.mjs",
    "check:all": "yarn line-contact:qa && yarn type-check && yarn lint && yarn test",
    "seo:qa": "node scripts/seo-qa.mjs",
    "ui:qa": "node scripts/ui-qa.mjs",
    "ads:qa": "yarn line-contact:qa && node scripts/google-ads-qa.mjs",
    "ads:readiness": "node scripts/google-ads-readiness-audit.mjs",
    "ads:browser-qa": "node scripts/google-ads-browser-qa.mjs",
    "gtm:setup": "node scripts/growth-stack-setup/gtm-setup.mjs",
    "ga4:setup": "node scripts/growth-stack-setup/ga4-setup.mjs",
    "pre-commit": "yarn check:all",
    "revalidate": "node scripts/revalidate.js",
    "revalidate:dev": "node scripts/revalidate.js && npm run dev",
    "clear-cache": "rm -rf .next/cache .next/server/app",
    "cf:build": "opennextjs-cloudflare build",
    "cf:types": "node scripts/generate-cloudflare-types.mjs",
    "cf:build:staging": "CMS_BUILD_ENV=staging NEXT_PUBLIC_GA4_MEASUREMENT_ID= opennextjs-cloudflare build --env=staging",
    "cf:build:production": "CMS_BUILD_ENV=production opennextjs-cloudflare build --env=production",
    "cf:preview": "opennextjs-cloudflare build && node scripts/preview-cms.mjs",
    "cf:deploy": "node scripts/refuse-direct-deploy.mjs",
    "deployment:policy": "node scripts/deployment-policy.mjs --check",
    "cf:check": "npm run type-check && npm run build && npm run cf:build",
    "line:dev": "wrangler dev --config workers/line-chat-history/wrangler.jsonc --port 8788",
    "line:deploy": "wrangler deploy --config workers/line-chat-history/wrangler.jsonc",
    "line:migrate": "wrangler d1 migrations apply siamrooftech-line-chat --remote --config workers/line-chat-history/wrangler.jsonc",
    "line:migrate:local": "wrangler d1 migrations apply siamrooftech-line-chat --local --config workers/line-chat-history/wrangler.jsonc",
    "line:types": "wrangler types --config workers/line-chat-history/wrangler.jsonc --env-interface CloudflareEnv workers/line-chat-history/src/worker-configuration.d.ts",
    "line:type-check": "tsc -p workers/line-chat-history/tsconfig.json --noEmit",
    "line:history": "node scripts/line-chat-history.mjs",
    "line:qa": "node scripts/line-chat-history-qa.mjs",
    "line-contact:qa": "node scripts/line-contact-contract-qa.mjs",
    "leads:list": "node scripts/leads.mjs list",
    "leads:show": "node scripts/leads.mjs show",
    "leads:transcript": "node scripts/leads.mjs transcript",
    "leads:unmatched": "node scripts/leads.mjs unmatched",
    "leads:status": "node scripts/leads.mjs status",
    "leads:value": "node scripts/leads.mjs value",
    "leads:match": "node scripts/leads.mjs match",
    "leads:ads-jobs": "node scripts/leads.mjs ads-jobs",
    "leads:qa": "node scripts/leads-qa.mjs",
    "admin:user:create": "node --import tsx scripts/admin-users.mjs create",
    "admin:user:grant": "node --import tsx scripts/admin-users.mjs grant",
    "admin:user:revoke": "node --import tsx scripts/admin-users.mjs revoke",
    "admin:user:inspect": "node --import tsx scripts/admin-users.mjs inspect",
    "admin:user:reset-password": "node --import tsx scripts/admin-users.mjs reset-password",
    "test:admin": "node --test scripts/admin-users.test.mjs && vitest run --config vitest.admin.config.ts",
    "test:admin:local": "node --import tsx --test scripts/admin-users.local.test.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@fortawesome/react-fontawesome": "^0.2.0",
    "@google/generative-ai": "^0.24.1",
    "@next/third-parties": "^15.5.9",
    "@opennextjs/cloudflare": "^1.19.11",
    "@opentelemetry/api": "^1.9.0",
    "@phosphor-icons/react": "^2.1.10",
    "@react-spring/web": "^9.7.3",
    "@tailwindcss/postcss": "^4.3.0",
    "@tiptap/core": "3.31.4",
    "@tiptap/extension-image": "3.31.4",
    "@tiptap/extension-link": "3.31.4",
    "@tiptap/extension-table": "3.31.4",
    "@tiptap/extension-table-cell": "3.31.4",
    "@tiptap/extension-table-header": "3.31.4",
    "@tiptap/extension-table-row": "3.31.4",
    "@tiptap/extension-unique-id": "3.31.4",
    "@tiptap/pm": "3.31.4",
    "@tiptap/react": "3.31.4",
    "@tiptap/starter-kit": "3.31.4",
    "@types/uuid": "^10.0.0",
    "better-auth": "1.7.7",
    "browser-image-compression": "^2.0.2",
    "canvas": "^3.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dommatrix": "^0.1.1",
    "drizzle-orm": "0.45.3",
    "lucide-react": "^1.46.0",
    "multer": "^2.0.2",
    "next": "^15.5.9",
    "pdfjs-dist": "^5.4.54",
    "react": "^18",
    "react-dom": "^18",
    "react-spring": "^9.7.3",
    "shadcn": "^4.11.0",
    "sharp": "^0.34.5",
    "sift": "^17.1.3",
    "swiper": "^11.0.6",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "uuid": "^11.1.0",
    "zod": "^3.25.76",
    "zustand": "^5.0.7"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.0.1",
    "daisyui": "^4.7.2",
    "drizzle-kit": "0.31.11",
    "eslint": "^8",
    "eslint-config-next": "^15.5.9",
    "google-auth-library": "^9.15.1",
    "happy-dom": "18.0.1",
    "postcss": "^8.5.15",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.5.3",
    "vitest": "3.2.4",
    "wrangler": "^4.132.0",
    "yaml": "^2.8.1"
  },
  "resolutions": {
    "@tiptap/core": "3.31.4",
    "@tiptap/pm": "3.31.4"
  }
}
